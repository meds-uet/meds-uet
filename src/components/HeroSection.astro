---
// Hero. Intentionally has NO background of its own: the shared backdrop is
// provided by the wrapper in pages/index.astro, so nothing changes color
// mid-screen between the hero and the MEDS-S1 section.
const stats = [
  { value: "30+", label: "Projects" },
  { value: "4", label: "Focus areas" },
  { value: "90+", label: "Members" },
];
---

<section id="hero-section" class="relative">
  <div
    class="container-shell flex min-h-[min(100svh,860px)] flex-col pb-10 pt-28 sm:pt-32 lg:pt-36"
  >
    <div
      class="grid flex-1 items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8"
    >
      <!-- Copy -->
      <div class="hero-in max-w-2xl">
        <a
          href="/meds-uet/meds-s1"
          class="group inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/[0.05] py-1.5 pl-3 pr-4 text-sm text-white/80 transition hover:border-white/30 hover:bg-white/10 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-peach"
        >
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span
              class="live-ping absolute inline-flex h-full w-full rounded-full bg-peach"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-peach"
            ></span>
          </span>
          MEDS-S1 RISC-V SoC program is active
        </a>

        <h1
          class="mt-7 text-5xl font-extrabold leading-[1.02] tracking-[-0.035em] text-white sm:text-6xl lg:text-[4.5rem]"
        >
          Engineering the future of open digital systems
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-8 text-white/70">
          Maktab-e-Digital Systems is a university center at UET Lahore for chip
          design, hardware tape-outs, and FPGA accelerators.
        </p>

        <div class="mt-9 flex flex-wrap gap-4">
          <a
            href="/meds-uet/projects"
            class="group inline-flex items-center gap-2 rounded-full bg-[#f3e9e8] px-7 py-3.5 text-sm font-semibold text-brand transition duration-300 hover:-translate-y-0.5 hover:bg-white hover:shadow-[0_0_30px_rgba(255,230,230,0.25)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            Explore projects
            <svg
              class="h-4 w-4 transition-transform group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
            >
          </a>
          <a
            href="/meds-uet/blog"
            class="inline-flex items-center rounded-full border border-white/25 px-7 py-3.5 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            Latest updates
          </a>
        </div>
      </div>

      <!-- The board is the one memorable element on this page -->
      <figure
        class="hero-board relative mx-auto w-full max-w-[600px] lg:ml-auto"
      >
        <div
          aria-hidden="true"
          class="absolute inset-[6%] rounded-full bg-[radial-gradient(circle,rgba(236,188,232,0.32)_0%,rgba(236,188,232,0)_68%)] blur-2xl"
        >
        </div>
        <img
          src="/meds-uet/images/hero-chip.png"
          alt="RISC-V MPW5 Chip fabricated by MEDS"
          class="relative w-full drop-shadow-[0_40px_70px_rgba(0,0,0,0.5)]"
          loading="eager"
        />
        <figcaption class="relative mt-1 text-center text-sm text-white/50">
          RISC-V MPW5 chip, fabricated by MEDS
        </figcaption>
      </figure>
    </div>

    <!-- <div class="mt-14 border-t border-white/10 pt-6 sm:mt-16">
      <dl class="grid max-w-xl grid-cols-3 gap-6">
        {
          stats.map((s) => (
            <div class="flex flex-col-reverse">
              <dt class="mt-1 text-sm text-white/55">{s.label}</dt>
              <dd class="text-4xl font-black tracking-tight text-white">
                {s.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div> -->
  </div>
</section>

<style>
  .hero-in {
    animation: hero-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero-board {
    animation: hero-board 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s both;
  }
  .live-ping {
    animation: live-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-board {
    from {
      opacity: 0;
      transform: translateX(24px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes live-ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in,
    .hero-board,
    .live-ping {
      animation: none;
    }
  }
</style>
