---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublications } from "@/lib/content";

const publications = await getPublications();
---

<BaseLayout
  title="Publications | MEDS (Maktab-e-Digital Systems)"
  description="Peer-reviewed journals, conference papers, and research posters from Maktab-e-Digital Systems."
>
  <!-- Hero Section -->
  <section class="page-hero">
    <div
      class="absolute inset-0 bg-gradient-to-br from-brand-deep via-brand-dark to-brand"
    >
    </div>

    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"
    >
    </div>

    <div
      class="absolute bottom-0 left-0 w-[300px] h-[300px] rounded-full bg-mauve/8 blur-[100px]"
    >
    </div>

    <div class="container-shell relative z-10">
      <div class="max-w-3xl space-y-5">
        <span class="eyebrow">Academic Research</span>

        <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
          Publications & Conference Papers
        </h1>

        <p class="text-lg leading-8 text-white/90">
          Peer-reviewed journal articles, conference papers, and technical
          posters detailing our work in RISC-V architectures, SoC design, and
          simulation acceleration.
        </p>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 pointer-events-none">
      <svg
        viewBox="0 0 1440 60"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-8 sm:h-12"
        preserveAspectRatio="none"
      >
        <path d="M0 60V30C360 45 1080 15 1440 30V60H0Z" fill="white"></path>
      </svg>
    </div>
  </section>

  <!-- Publications -->
  <section class="container-shell py-12 lg:py-16">
    <div class="space-y-6">
      {
        publications.map((pub) => (
          <div class="group relative rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-sm transition-all duration-300 hover:border-brand/40 hover:shadow-xl">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
              <div class="max-w-4xl space-y-3">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="rounded-full bg-brand-dark px-3 py-1 text-xs font-extrabold text-white">
                    {pub.year}
                  </span>

                  <span class="text-xs font-bold uppercase tracking-wider text-brand">
                    {pub.venue}
                  </span>
                </div>

                <h2 class="text-xl font-bold leading-snug text-brand-dark transition-colors group-hover:text-brand sm:text-2xl">
                  {pub.title}
                </h2>

                <p class="text-sm font-medium leading-relaxed text-ink/75">
                  <span class="font-bold text-brand-dark/90">Authors:</span>{" "}
                  {pub.authors}
                </p>
              </div>

              <div class="shrink-0 w-full lg:w-44 flex justify-center lg:justify-end lg:self-center">
                {pub.link ? (
                  <a
                    href={pub.link}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex w-44 items-center justify-center gap-2 rounded-xl bg-brand px-5 py-3 text-sm font-bold text-white shadow-md transition-all duration-200 hover:bg-brand-dark hover:shadow-lg"
                  >
                    <span>View More</span>

                    <svg
                      class="h-4 w-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"
                      />
                    </svg>
                  </a>
                ) : (
                  <span class="inline-flex w-44 items-center justify-center rounded-xl border border-slate-200 bg-slate-100 px-5 py-3 text-sm font-bold text-slate-500">
                    Published
                  </span>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
