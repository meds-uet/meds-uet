---
import BaseLayout from '@/layouts/BaseLayout.astro';

const subprojects = [
  { code: 'M1', title: 'UART Peripheral Integration and HAL Driver', owner: 'Mudassar Hussain', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M2', title: 'SPI Master Peripheral, Driver and Flash Boot Path', owner: 'Noor Ul Huda', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M3', title: 'GPIO and Timer Peripherals with Drivers', owner: 'Mujeeb Ur Rehman', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M4', title: 'Boot ROM and Second-Stage Loader', owner: 'NA', status: 'Not Started', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M5', title: 'PMA Check Unit — Directed Testbench', owner: 'NA', status: 'Not Started', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M7', title: 'CoreMark and Dhrystone Benchmark Harness', owner: 'M. Kaleem Faryad', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M8', title: 'Embench-IoT Port and Automated Regression', owner: 'M. Kaleem Faryad', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M9', title: 'libs1_perf — the Performance Measurement Library', owner: 'NA', status: 'Not Started', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M10', title: 'Lint, Coding Standard and CI Documentation Gates', owner: 'Javeria', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M11', title: 'RISC-V Architectural Compatibility Tests (ACT) - Triage and Reporting', owner: 'Hamza Ali', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M12', title: 'Xilinx IP Survey and Evaluation for KC705 Synthesis', owner: 'Noor Fatima / Muhammad Faizan', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M13', title: 'Module Documentation and Interface-Contract Sweep', owner: 'NA', status: 'Not Started', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M14', title: 'Literature Review — Open-Source RISC-V Core Microarchitectures', owner: 'Essa, Ismail', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'M15', title: 'Literature Review — Accelerator Coupling and Measurement & Methodology', owner: 'Muhammad Farhan, Asim, Muhammad Abdullah', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'T1', title: 'Core Frontend — PC, Branch Prediction and Fetch Interface', owner: 'Ayesha, Ammarah, Eman', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'T2', title: 'Core Backend — Decode, Register File, ALU and Hazard Control', owner: 'Ayesha, Ammarah, Eman', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'T3', title: 'CSR File, Trap Architecture and Performance Counters', owner: 'Abdur Rahman Mirza', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'T4', title: 'AXI4 Fabric - Crossbar, Width Adaptation and Address Decode', owner: 'Eman Maqsood', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'T5', title: 'CLINT and PLIC - the Interrupt Subsystem', owner: 'Abdullah Khan, Abdur Rafay', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'T6', title: 'Board Support Package - crt0, newlib, HAL and make run', owner: 'NA', status: 'Not Started', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'T7', title: 'Architectural Tests (ACT4) and Co-simulation in CI', owner: 'Hamza Ali', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'T8', title: 'KC705 Board Port - DDR3 Bring-Up and Timing Closure', owner: 'Hafiz Usman Abdullah, Umer Faisal', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'R1', title: 'Completion Buffer, Retire Logic and the MXIF Port', owner: 'Mushaf', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'R2', title: 'Load/Store Unit, Store Buffer, PMP and Atomics', owner: 'Ali Hassan', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'R3', title: 'Instruction and Data Caches, Zicbom and the SRAM Wrapper', owner: 'Muhammad Usman', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'R4', title: 'The SoC Generator - soc.yaml to RTL, Linker, Headers and DTS', owner: 'NA', status: 'Not Started', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'R5', title: 'RVFI Trace Port and the Spike Co-simulation Harness', owner: 'NA', status: 'Not Started', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'R6', title: 'Debug Module, JTAG DTM, OpenOCD and Semihosting', owner: 'Muhammad Yousaf, Muhammad Husnain Jatoi, Muhammad Zakria Khan, Ahmed Hashim, Muhammad Zain, M.Sami', status: 'In Progress', link: 'https://github.com/meds-uet/MEDS-S1' },
  { code: 'R7', title: 'Accelerator Socket and the Conformance Testbenches', owner: 'NA', status: 'Not Started', link: 'https://github.com/meds-uet/MEDS-S1' }
];

const activeCount = subprojects.filter((item) => item.status === 'In Progress').length;
const notStartedCount = subprojects.filter((item) => item.status === 'Not Started').length;
---

<BaseLayout title="MEDS-S1 | MEDS" description="MEDS-S1 is the flagship RISC-V SoC program at MEDS, covering architecture, verification, SoC integration, debugging, and software bring-up.">
  <section class="page-hero">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-deep via-brand-dark to-brand"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="container-shell relative z-10">
      <div class="max-w-4xl space-y-6">
        <span class="eyebrow">Flagship program</span>
        <h1 class="text-4xl font-black leading-tight sm:text-5xl lg:text-6xl">MEDS-S1</h1>
        <p class="text-lg leading-8 text-white/90">
          The current MEDS flagship initiative for a full RISC-V system-on-chip program, connecting architecture, RTL, verification, boot software, debugging, and CI-driven validation in one coordinated effort.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="https://github.com/meds-uet/MEDS-S1" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-full bg-peach px-6 py-3 text-sm font-bold text-brand-dark transition duration-300 hover:-translate-y-0.5 hover:bg-white">Global project link</a>
          <a href="/meds-uet/projects" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-3 text-sm font-bold text-white transition duration-300 hover:bg-white/10">Back to projects</a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 pointer-events-none">
      <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-8 sm:h-12" preserveAspectRatio="none">
        <path d="M0 60V30C360 45 1080 15 1440 30V60H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <section class="container-shell -mt-8 relative z-20 pb-8">
    <div class="grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-ink/55">Subprojects</p>
        <p class="mt-3 text-3xl font-black text-brand-dark">{subprojects.length}</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-ink/55">Active</p>
        <p class="mt-3 text-3xl font-black text-emerald-600">{activeCount}</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-ink/55">Not started</p>
        <p class="mt-3 text-3xl font-black text-amber-600">{notStartedCount}</p>
      </div>
    </div>
  </section>

  <section class="container-shell py-12 lg:py-16">
    <div class="mb-8 max-w-2xl">
      <span class="eyebrow">Program breakdown</span>
      <h2 class="mt-2 text-3xl font-bold text-brand sm:text-4xl">Sub-projects and workstreams</h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {subprojects.map((project) => (
        <article class="group flex h-full flex-col justify-between rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand/40 hover:shadow-xl">
          <div>
            <div class="mb-4 flex items-start justify-between gap-3">
              <span class="inline-flex items-center rounded-full bg-brand/10 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-[0.18em] text-brand">{project.code}</span>
              <span class={`inline-flex items-center rounded-full px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-[0.18em] ${project.status === 'Not Started' ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700'}`}>
                {project.status}
              </span>
            </div>

            <h3 class="text-xl font-bold leading-snug text-brand-dark">{project.title}</h3>

            <div class="mt-4 space-y-2 text-sm text-ink/75">
              <div class="flex items-start gap-2">
                <span class="mt-0.5 text-brand">●</span>
                <span><span class="font-semibold text-brand-dark">Owner:</span> {project.owner}</span>
              </div>
            </div>
          </div>

          <div class="mt-6 border-t border-slate-100 pt-4">
            <a href={project.link} target="_blank" rel="noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-50 px-4 py-2.5 text-xs font-bold text-brand transition hover:bg-brand hover:text-white">
              MEDS-S1 repo
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
